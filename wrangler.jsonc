{
  "name": "heronscribe-website",
  "compatibility_date": "2026-09-16",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Free Workers rate limit for POST /api/check: one shared counter, not per visitor.
  "ratelimits": [
    {
      "name": "CHECK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 10 }
    }
  ]
}
